{
    "compilerOptions": {
        "target": "ES2022" /* Specify ECMAScript target version. */,
        "module": "node16" /* Specify module code generation. */,
        "lib": [
            "ES2022",
            "DOM"
        ] /* Specify library files to be included in the compilation. */,
        /* TypeScript 6 turned `strict` on by default. This project has never been strict
           (see `noImplicitAny` below), and turning it on now would change the public
           signatures of `getPermissionsFromAccount` / `getIdentityFromAccount`. Kept off
           deliberately; enabling it is tracked as follow-up work. */
        "strict": false,
        "declaration": true,
        "declarationMap": true,
        "allowJs": false,
        "jsx": "react" /* Specify JSX code generation: 'preserve', 'react-native', or 'react'. */,
        "noImplicitAny": false /* Raise error on expressions and declarations with an implied 'any' type. */,
        "noFallthroughCasesInSwitch": true /* Report errors for fallthrough cases in switch statement. */,
        "moduleResolution": "node16" /* Specify module resolution strategy. */,
        "allowSyntheticDefaultImports": true /* Allow default imports from modules with no default export. This does not affect code emit, just typechecking. */,
        "esModuleInterop": true /* Enables emit interoperability between CommonJS and ES Modules via creation of namespace objects for all imports. Implies 'allowSyntheticDefaultImports'. */,
        "skipLibCheck": true
    }
}
