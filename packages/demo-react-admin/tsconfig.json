{
    "compilerOptions": {
        /* TypeScript 6 turned `strict` on by default. This demo has never been strict;
           keeping it off avoids unrelated churn across the UI code. */
        "strict": false,
        "outDir": "lib",
        "rootDir": "src",
        "declaration": true,
        "allowJs": false,
        "jsx": "react",
        "lib": ["ES2022", "DOM"],
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node", "vite/client"],
    },
    "include": ["src"]
}
